@page "/inventories/edit/{InventoryId:int}"

@inject NavigationManager NavigationManager
@inject IEditInventoryUseCase EditInventoryUseCase

<h3>Edit Inventory</h3>

<br/>

<EditForm Model="inventory" FormName="formInventory" OnValidSubmit="Save"> 
    <DataAnnotationsValidator/>
    <div class="form-group">
        <label for="name">Inventory Name</label>
        <InputText id="name" @bind-Value="inventory.InventoryName" class="form-control" />
        <ValidationMessage For="() => inventory.InventoryName"></ValidationMessage>
    </div>
    <div class="form-group">
        <label for="quantity">Quantity</label>
        <InputNumber id="quantity" @bind-Value="inventory.Quantity" class="form-control"/>
        <ValidationMessage For="() => inventory.Quantity"></ValidationMessage>
    </div>
    <div class="form-group">
        <label for="price">Price</label>
        <InputNumber id="price" @bind-Value="inventory.Price" class="form-control"/>    
        <ValidationMessage For="() => inventory.Price"></ValidationMessage>
    </div>

    <br/>
    <button type="submit" class="btn btn-primary">Save</button>
    <a type="button" class="btn btn-secondary" href="/inventories">Cancel</a>
</EditForm> 

@code {

    [SupplyParameterFromForm]
    private Inventory inventory { get; set; } 

    [Parameter]
    public int InventoryId { get; set; }


    protected override async Task OnInitializedAsync()
    {
        if(InventoryId != null)
        {
            inventory = await EditInventoryUseCase.FindInventoryByIdAsync(int.Parse(InventoryId.ToString()));
        }
    }

    private async Task Save()
    {
       inventory.InventoryId = InventoryId;

       await EditInventoryUseCase.ExecuteAsync(inventory);
       NavigationManager.NavigateTo("/inventories");
    }

}

@page "/editproduct/{prodId:int}"

@inject NavigationManager NavigationManager
@inject IViewProductByIdUseCase ViewProductByIdUseCase
@inject IEditProductUseCase EditProductUseCase

<h3>Edit Product</h3>

<br/>

@if (product is null)
{
    <p><em>Loading...</em></p>
}
else
{
   <EditForm Model="product" FormName="formProduct" OnValidSubmit="Update"> 
       <DataAnnotationsValidator/>

       <InputNumber @bind-Value="product.ProductId" hidden></InputNumber>

       <div class="form-group">
           <label for="name">Product Name</label>
           <InputText id="name" @bind-Value="product.ProductName" class="form-control" />
           <ValidationMessage For="() => product.ProductName"></ValidationMessage>
       </div>
       <div class="form-group">
           <label for="quantity">Quantity</label>
           <InputNumber id="quantity" @bind-Value="product.Quantity" class="form-control"/>
           <ValidationMessage For="() => product.Quantity"></ValidationMessage>
       </div>
       <div class="form-group">
           <label for="price">Price</label>
           <InputNumber id="price" @bind-Value="product.Price" class="form-control"/>    
           <ValidationMessage For="() => product.Price"></ValidationMessage>
       </div>

       <br/>
       <button type="submit" class="btn btn-primary">Update</button>
       <a type="button" class="btn btn-secondary" href="/inventories">Cancel</a>
   </EditForm> 
}

@code {

    [Parameter]
    public int prodId { get; set; }

    [SupplyParameterFromForm]
    private Product? product { get; set; }  

    protected override async Task OnParametersSetAsync()
    {  
        this.product ??= await ViewProductByIdUseCase.ExecuteAsync(prodId);   
        
         if (this.product is null)
        {
            NavigationManager.NotFound();            
        }

    }

    private async Task Update()
    {       

        if (product is not null) 
        {
            await EditProductUseCase.ExecuteAsync(product);
            NavigationManager.NavigateTo("/products");
        }
    }
}
